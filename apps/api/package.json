{
  "name": "@parallax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:worker": "tsx src/worker/index.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "seed": "tsx src/seed/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.16",
    "@parallax/graphql": "*",
    "@parallax/shared": "*",
    "@parallax/types": "*",
    "bullmq": "^5.44.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "express": "^5.1.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mongoose": "^8.14.0",
    "pino": "^9.6.0",
    "pino-http": "^10.5.0",
    "ws": "^8.21.3",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
