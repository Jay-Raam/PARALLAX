# ─────────────────────────────────────────────────────────────
# PARALLAX environment variables
# Copy to .env and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Shared ──────────────────────────────────────────────────
NODE_ENV=development

# ── Backend (apps/api) ──────────────────────────────────────
PORT=4000

# MongoDB connection string (required; e.g. docker-compose or your own instance)
MONGODB_URI=mongodb://localhost:27017/parallax
# In-memory MongoDB (great for local dev without installing Mongo):
# MONGODB_URI=mongodb-memory

# Redis connection string (required for queues/caching/rate-limits/pub-sub)
REDIS_URL=redis://localhost:6379
# In-memory Redis (single-process dev mode):
# REDIS_URL=memory

# GitHub OAuth application credentials (https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the OAuth app callback URL, e.g. http://localhost:4000/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/auth/github/callback
# Secret used to verify GitHub webhook signatures (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# Secrets. SESSION_SECRET signs auth cookies. ENCRYPTION_KEY encrypts
# stored GitHub tokens (32 bytes, hex/base64 — run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# Run BullMQ workers inside the API process ("embedded") instead of a
# separate worker process. Required when REDIS_URL=memory. Set to "separate" for production.
WORKER_MODE=embedded

# ── Frontend (apps/web) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
